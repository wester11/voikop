{
  "tag": "__SET_UNIQUE_INBOUND_TAG__",
  "listen": "0.0.0.0",
  "port": 443,
  "protocol": "vless",
  "settings": {
    "clients": [],
    "decryption": "none",
    "fallbacks": [{ "dest": "127.0.0.1:8080" }]
  },
  "streamSettings": {
    "network": "raw",
    "security": "tls",
    "tlsSettings": {
      "minVersion": "1.2",
      "maxVersion": "1.3",
      "certificates": [{
        "certificateFile": "/etc/letsencrypt/live/current/fullchain.pem",
        "keyFile": "/etc/letsencrypt/live/current/privkey.pem"
      }]
    }
  }
}
